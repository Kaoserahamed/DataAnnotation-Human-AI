# ──────────────────────────────────────────────────────────────────────────────
# Human + AI Annotation Platform — root .env.example
#
# This file documents every environment variable accepted by the platform.
# The full, commented version lives at:  apps/api/.env.example
#
# USAGE (Postgres path)
#   cp .env.example .env
#   # edit .env, then:
#   docker compose up -d
#   npm install && npm run db:migrate && npm run dev
#
# USAGE (embedded PGlite, zero external services)
#   npm install && npm run dev   # no .env needed — all vars have dev defaults
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production (>= 32 chars).  Generate: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── Database ──────────────────────────────────────────────────────────────────
# pglite = zero-config embedded DB (dev/test)
# postgres = external PostgreSQL (production)
DB_CLIENT=pglite
DATABASE_URL=postgres://annotation:annotation_dev_pw@localhost:5432/annotation
PGLITE_DIR=

# Postgres credentials consumed by docker-compose.yml
POSTGRES_DB=annotation
POSTGRES_USER=annotation
POSTGRES_PASSWORD=annotation_dev_pw
POSTGRES_PORT=5432

# ── AI Provider ───────────────────────────────────────────────────────────────
# heuristic = no API key needed (good for dev/CI)
# openai    = GPT-4o-mini (requires OPENAI_API_KEY)
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Observability ─────────────────────────────────────────────────────────────
# Structured log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Sentry DSN — leave blank to disable error tracking
SENTRY_DSN=

# ── Seeding (optional) ────────────────────────────────────────────────────────
# Password for all demo users created by: npm run db:seed
# If blank, a random password is generated and printed to stdout.
SEED_PASSWORD=
