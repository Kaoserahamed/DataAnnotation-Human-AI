# ──────────────────────────────────────────────────────────────────────────────
# Human + AI Annotation Platform — API environment variables
#
# USAGE
#   cp apps/api/.env.example apps/api/.env
#   # Edit apps/api/.env with your values (never commit that file)
#
# All variables have safe development defaults; only JWT_SECRET is required
# when NODE_ENV=production. Generate one with:
#   openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────

# Environment: development | test | production
NODE_ENV=development

# Interface to bind (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# Port the API listens on
PORT=4000

# Allowed CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────

# ⚠ REQUIRED in production (>= 32 characters).
# Generate: openssl rand -hex 32
# Leave blank in development to use the built-in insecure default.
JWT_SECRET=

# JWT lifetime (ms format, e.g. 12h, 7d, 1y)
JWT_EXPIRES_IN=12h

# ── Database ──────────────────────────────────────────────────────────────────

# pglite = embedded Postgres-compatible DB (zero setup, dev/test only)
# postgres = external PostgreSQL server (required for production)
DB_CLIENT=pglite

# Used when DB_CLIENT=postgres
DATABASE_URL=postgres://annotation:annotation_dev_pw@localhost:5432/annotation

# Used when DB_CLIENT=pglite in production to persist data across restarts.
# Leave blank for in-memory (development/test).
PGLITE_DIR=

# ── AI Provider ───────────────────────────────────────────────────────────────

# heuristic = deterministic rule-based (no API key needed, good for dev/CI)
# openai    = GPT-4o-mini by default (requires OPENAI_API_KEY)
AI_PROVIDER=heuristic

# Required when AI_PROVIDER=openai
OPENAI_API_KEY=

# Override the OpenAI-compatible endpoint (e.g. Azure OpenAI, Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name passed to the completions endpoint
OPENAI_MODEL=gpt-4o-mini

# ── Seeding (optional) ────────────────────────────────────────────────────────

# Password assigned to all demo users when running: npm run db:seed
# If left blank, a random password is generated and printed to stdout.
SEED_PASSWORD=
