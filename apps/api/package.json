{
  "name": "@haap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted annotation platform API: pre-labeling, human verification, QC, gold promotion and analytics.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project api",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@haap/shared": "0.1.0",
    "fastify": "5.12.5",
    "jose": "6.1.1",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.21.0"
  }
}
