{
  "name": "human-ai-annotation-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted data annotation platform with human verification, gold dataset promotion and annotation analytics.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "dev": "npm run dev --workspace @haap/api",
    "dev:web": "npm run dev --workspace @haap/web",
    "db:migrate": "npm run db:migrate --workspace @haap/api",
    "db:seed": "npm run db:seed --workspace @haap/api",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
